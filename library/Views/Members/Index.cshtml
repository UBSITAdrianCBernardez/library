@model IEnumerable<library.Models.Member>
@{
    ViewData["Title"] = "Members Directory";
}

<div class="container py-4">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Header Section -->
        <div class="card-header bg-gradient bg-dark text-white p-4 d-flex justify-content-between align-items-center border-bottom border-secondary">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-25 p-3 rounded-3 text-info border border-primary border-opacity-50 fs-4">
                    👥
                </div>
                <div>
                    <h3 class="mb-1 fw-bold text-white tracking-wide">Members Directory</h3>
                    <p class="mb-0 text-white-50 small">Manage registered library patrons and active accounts</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm d-flex align-items-center gap-2">
                <span>+</span> Create New Member
            </a>
        </div>

        <!-- Table Body Container -->
        <div class="card-body p-0 bg-white">
            <div class="table-responsive">
                <table class="table table-borderless align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase fs-7 border-bottom">
                        <tr>
                            <th class="py-3 ps-4 fw-semibold">Full Name</th>
                            <th class="py-3 fw-semibold">Email</th>
                            <th class="py-3 fw-semibold">Member Type</th>
                            <th class="py-3 fw-semibold">Open Loans</th>
                            <th class="py-3 text-end pe-4 fw-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom border-light position-relative">
                                <td class="ps-4 py-3 fw-bold text-dark">
                                    <span class="text-primary me-2">▪</span> @item.FullName
                                </td>
                                <td class="py-3 text-secondary">
                                    @(item.Email ?? "—")
                                </td>
                                <td class="py-3">
                                    @if (item.MemberType == "Faculty")
                                    {
                                        <span class="badge bg-info bg-opacity-15 text-dark border border-info px-3 py-1 rounded-pill fw-semibold">Faculty</span>
                                    }
                                    else if (item.MemberType == "Student")
                                    {
                                        <span class="badge bg-secondary bg-opacity-15 text-dark border border-secondary px-3 py-1 rounded-pill fw-semibold">Student</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border px-3 py-1 rounded-pill fw-semibold">@item.MemberType</span>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (item.OpenLoans > 0)
                                    {
                                        <span class="badge bg-warning text-dark px-2.5 py-1 rounded-circle fw-bold">@item.OpenLoans</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-primary px-3 rounded-pill fw-semibold shadow-sm">Loans</a>
                                        <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-secondary px-3 rounded-pill fw-semibold shadow-sm">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-danger px-3 rounded-pill fw-semibold shadow-sm">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>