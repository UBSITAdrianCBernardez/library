@model library.Models.MemberDetails
@{
    ViewData["Title"] = "Member Loan History";
}

<div class="container my-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded p-4">
            <h2 class="text-primary mb-1">👤 @Model.Member.FullName</h2>
            <p class="text-muted mb-2">Email: <strong>@(Model.Member.Email ?? "No email provided")</strong> | Type: <span class="badge bg-info text-dark">@Model.Member.MemberType</span></p>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">← Back to Members</a>
        </div>
    </div>

    <h4 class="mb-3">Loan Records</h4>
    @if (Model.Loans == null || !Model.Loans.Any())
    {
        <div class="alert alert-info py-3">
            <i class="bi bi-info-circle"></i> This member has never borrowed any books yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Book Title</th>
                            <th>Loaned On</th>
                            <th>Returned On</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.Loans)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@loan.BookTitle</td>
                                <td>@loan.LoanedOn.ToString("yyyy-MM-dd")</td>
                                <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="text-end pe-4">
                                    @if (loan.ReturnedOn == null)
                                    {
                                        <span class="badge bg-warning text-dark">Active (Out)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Returned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>