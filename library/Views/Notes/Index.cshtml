@model IEnumerable<library.Controllers.NoteItem>
@{
    ViewData["Title"] = "Notepad";
}

<div class="container mt-4">
    <h2>Library Notepad</h2>
    <hr />

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Body</th>
                <th>Created On</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var note in Model)
                {
                    <tr>
                        <td>@note.NoteId</td>
                        <td>@note.Title</td>
                        <td>@(note.Body ?? "—")</td>
                        <td>@note.CreatedOn</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No notes found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>